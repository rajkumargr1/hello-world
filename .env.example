# Example environment variables for the Email-Based Equipment Movement Processor
# Rename this file to .env and fill in your actual credentials.
# DO NOT commit your actual .env file to version control if it contains sensitive data.

# Email Account Credentials
# This is the password for the email account specified in config/config.yaml (email_server.user)
# For Gmail, you might need to use an "App Password".
EMAIL_PASSWORD="YOUR_EMAIL_ACCOUNT_PASSWORD"

# LLM API Key
# The name of this variable (e.g., GEMINI_API_KEY) MUST MATCH
# the 'api_key_env_var' value in config/config.yaml under the 'llm' section.
# Example if config.yaml has:
# llm:
#   api_key_env_var: "GEMINI_API_KEY"
# Then use GEMINI_API_KEY here.
GEMINI_API_KEY="YOUR_LLM_API_KEY"

# Other potential environment variables can be added here if needed by the application.
# For example, if you decide to make IMAP host/user configurable via env vars as well.
# IMAP_HOST="imap.example.com"
# IMAP_USER="user@example.com"
